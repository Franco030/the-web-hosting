# Puerto del API
PORT=4000
# Origen del frontend (CORS y Socket.IO)
CORS_ORIGIN=http://localhost:5173

# Base de datos (ORM Sequelize). sqlite por defecto; mysql o postgres en producción.
DB_DIALECT=sqlite
DB_STORAGE=./data/hosting.sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=the_web_hosting
# DB_USER=root
# DB_PASSWORD=

# Autenticación de administradores
JWT_SECRET=cambia-esta-clave-larga-y-aleatoria
JWT_EXPIRES_IN=8h
ADMIN_SEED_EMAIL=admin@thewebhosting.test
ADMIN_SEED_PASSWORD=Admin123!

# Correo del formulario de contacto. Sin SMTP_HOST se usa una cuenta de prueba de Ethereal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
CONTACT_TO=contacto@thewebhosting.test
